# Adgangskodebeskyttelse: alle forespørgsler sendes gennem _auth/gate.php,
# som kun udleverer filen, hvis man er logget ind.
#
# Bevidst uden <IfModule>: mangler serveren mod_rewrite, giver den en fejl
# i stedet for at vise siden ubeskyttet.

RewriteEngine On

# Hvis siden ligger i en undermappe og ikke virker, så fjern # på næste linje
# og ret stien til mappen, f.eks. /oddy/
# RewriteBase /

RewriteCond %{REQUEST_URI} !/_auth/(login|gate)\.php$
RewriteRule ^(.*)$ _auth/gate.php?p=$1 [L,B]
